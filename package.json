{
  "name": "seb-linux",
  "productName": "Safe Exam Browser for Linux",
  "version": "1.2.0",
  "description": "An unofficial, independent Safe Exam Browser client for Linux (Ubuntu/ZorinOS and derivatives).",
  "license": "MIT",
  "author": {
    "name": "Noé Bachofner",
    "email": "noebachofner@lxrin.ch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noebachofner/Save-Exam-Browser-for-Linux.git"
  },
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf dist release",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "start": "npm run build && electron dist/main/index.js",
    "dist:appimage": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:deb": "npm run build && electron-builder --linux deb --publish never",
    "dist": "npm run build && electron-builder --linux AppImage deb pacman --publish never",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dist:pacman": "npm run build && electron-builder --linux pacman --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "electron": "^44.11.4",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "ch.lxrin.seblinux",
    "productName": "Safe Exam Browser for Linux",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "category": "Education",
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "desktop": {
        "entry": {
          "Name": "Safe Exam Browser for Linux",
          "MimeType": "x-scheme-handler/seb;x-scheme-handler/sebs;application/x-seb;",
          "Categories": "Education;",
          "Keywords": "exam;seb;safeexambrowser;"
        }
      },
      "maintainer": "Noé Bachofner <noebachofner@lxrin.ch>",
      "synopsis": "Unofficial SEB-compatible exam browser for Linux",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "description": "Independent, Safe Exam Browser compatible exam browser for Linux. Reads .seb configurations and seb:// links, computes the SEB Config Key, and sends the SEB integrity headers so exam platforms recognise the session."
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib"
      ],
      "fpm": [
        "build/ch.lxrin.seblinux.metainfo.xml=/usr/share/metainfo/ch.lxrin.seblinux.metainfo.xml"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "noebachofner",
        "repo": "Save-Exam-Browser-for-Linux"
      }
    ],
    "deb": {
      "fpm": [
        "build/ch.lxrin.seblinux.metainfo.xml=/usr/share/metainfo/ch.lxrin.seblinux.metainfo.xml"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "homepage": "https://github.com/noebachofner/Save-Exam-Browser-for-Linux"
}
